<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Only apps signed like the module may drive the session receiver that
         SessionBackup registers inside Facebook's process. -->
    <permission
        android:name="tn.loukious.facebookappadsremover.permission.SESSION_BACKUP"
        android:protectionLevel="signature" />
    <uses-permission android:name="tn.loukious.facebookappadsremover.permission.SESSION_BACKUP" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/module_name"
        android:description="@string/module_description"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FBAR">

        <meta-data
            android:name="xposeddescription"
            android:value="@string/module_description" />
        <meta-data
            android:name="xposedscope"
            android:value="com.facebook.katana" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true" />

        <!-- Drawer entry. Deliberately an alias rather than an intent-filter on
             the activity: ui.LauncherIcon hides the icon by disabling this
             component, which leaves MainActivity exported and startable by
             explicit intent — the recovery path when the icon is gone.
             Disabling the activity itself would make it unstartable. -->
        <activity-alias
            android:name=".ui.LauncherAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Always enabled. PackageManager.getLaunchIntentForPackage()
             resolves CATEGORY_INFO before CATEGORY_LAUNCHER, so this keeps the
             package's front door resolvable while the drawer icon is hidden —
             the Xposed module list opens a module's settings through that
             call, and nothing else in this app starts MainActivity.
             Trade-off: the launcher's own all-apps list queries
             CATEGORY_LAUNCHER and so ignores this entry, but Pixel Launcher's
             SEARCH does surface it, rendered as package information — a search
             hit opens App Info rather than this screen. The alternative is
             hiding the package from search entirely at the cost of the
             manager's settings button. -->
        <activity-alias
            android:name=".ui.InfoAlias"
            android:targetActivity=".ui.MainActivity"
            android:exported="true"
            android:label="@string/module_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity-alias>

        <!-- Session export/import results from the Facebook process
             (core.SessionBackup). Manifest-registered so it also works when
             the activity is gone; the FB side targets our package
             explicitly, which is delivered despite the implicit-broadcast
             ban. -->
        <receiver
            android:name=".ui.SessionResultReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="tn.loukious.facebookappadsremover.action.SESSION_RESULT" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
